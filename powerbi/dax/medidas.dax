// Crie as medidas numa tabela dedicada chamada _Medidas (Modelagem > Nova tabela):
// _Medidas = { ("Medidas", 1) }
// Depois crie as medidas abaixo (Modelagem > Nova medida). Os nomes das views
// correspondem a powerbi/sql/01_views_itsm.sql.

Chamados =
COUNTROWS ( 'vw_bi_chamado' )

Chamados abertos =
CALCULATE (
    [Chamados],
    FILTER (
        'vw_bi_chamado',
        ISBLANK ( 'vw_bi_chamado'[dt_resolucao] )
    )
)

Chamados resolvidos =
CALCULATE (
    [Chamados],
    FILTER (
        'vw_bi_chamado',
        NOT ISBLANK ( 'vw_bi_chamado'[dt_resolucao] )
    )
)

% chamados resolvidos =
DIVIDE ( [Chamados resolvidos], [Chamados] )

Tempo médio de resolução (h) =
DIVIDE (
    AVERAGE ( 'vw_bi_chamado'[minutos_ate_resolucao] ),
    60
)

Tempo médio em aberto (h) =
DIVIDE (
    AVERAGE ( 'vw_bi_chamado'[minutos_em_aberto] ),
    60
)

Chamados com SLA =
DISTINCTCOUNT ( 'vw_bi_chamado_sla'[id_chamado] )

Violações de SLA =
CALCULATE (
    COUNTROWS ( 'vw_bi_chamado_sla' ),
    'vw_bi_chamado_sla'[fl_breach] = TRUE ()
)

% violações SLA =
DIVIDE ( [Violações de SLA], COUNTROWS ( 'vw_bi_chamado_sla' ) )

CSAT médio =
AVERAGE ( 'vw_bi_csat'[nr_score] )

Avaliações CSAT =
COUNTROWS ( 'vw_bi_csat' )

Chamados avaliados =
DISTINCTCOUNT ( 'vw_bi_csat'[id_chamado] )

Comentários CSAT =
COUNTROWS (
    FILTER (
        'vw_bi_csat',
        NOT ISBLANK ( 'vw_bi_csat'[comentario] )
    )
)

Tempo médio em status (h) =
DIVIDE (
    AVERAGE ( 'vw_bi_chamado_status_historico'[minutos_no_status] ),
    60
)
